# Obsidian-Jules Environment Variables Example

# Option A: Local Co-Pilot (Claude Code)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option B: Cloud Autonomous Agent (Google Jules)
# Get your API key or authenticate via `jules login` at https://jules.google.com
JULES_API_KEY=your_jules_api_key_here

# Optional: GitHub CLI token for automated PR operations
GH_TOKEN=your_github_personal_access_token_here
